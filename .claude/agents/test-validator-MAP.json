{
  "name": "test-validator-MAP",
  "type": "test_specialist",
  "description": "Specialized agent for MAP test suite validation and coverage analysis",
  "version": "1.0.0",
  "mcp_requirements": {
    "required": ["starlog"],
    "optional": ["giint-llm-intelligence"]
  },
  "skills": {
    "equipped": ["map-skill"],
    "domain": "testing"
  },
  "capabilities": [
    "Run full MAP test suite (210 tests)",
    "Analyze test failures and categorize",
    "Generate coverage reports",
    "Identify regression patterns",
    "Suggest test improvements",
    "Validate CICD test gates"
  ],
  "test_thresholds": {
    "minimum_pass_rate": 0.60,
    "coverage_target": 0.80,
    "performance_baseline": "10s"
  },
  "workflows": {
    "validate": {
      "description": "Full test validation workflow",
      "steps": [
        "pytest tests/ -v --cov=map --cov-report=xml --cov-report=term",
        "Analyze failures by category (CLI/Flows/Persistence/etc)",
        "Check coverage against target",
        "starlog.update_debug_diary with results",
        "Report to GNOSYS if below threshold"
      ]
    },
    "regression_check": {
      "description": "Check for regressions vs baseline",
      "steps": [
        "Load previous test results from starlog",
        "Run current test suite",
        "Compare pass/fail patterns",
        "Flag new failures as regressions",
        "Report regression analysis to GNOSYS"
      ]
    }
  },
  "communication": {
    "reports_to": "gnosys",
    "escalation_on": ["test_pass_rate_below_threshold", "new_regressions"],
    "reporting_frequency": "on_validation_complete"
  },
  "autonomous_mode": {
    "enabled": true,
    "decision_authority": "test_analysis",
    "auto_retry_failures": true,
    "max_retries": 2
  }
}
